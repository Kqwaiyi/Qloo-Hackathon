# Copy to .env.local for local development. Secrets never go in tracked files.

# Neon Postgres (set by the Vercel Marketplace integration). Leave unset locally to use an
# on-disk PGlite database in .data/pglite instead.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Required on Vercel. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Optional: the URL the app is served from. Defaults to the Vercel deployment URL, or
# http://localhost:3000 in local development.
# BETTER_AUTH_URL=

# The private Vercel Blob store for photos and Previews (set by Vercel on Production and Preview).
# Leave unset locally to keep them in .data/blob instead.
# BLOB_READ_WRITE_TOKEN=

# Which AI the app runs on: the fake adapter (fake, the default) or Gemini (gemini), which costs money
# and runs only when switched on here. Gemini needs GEMINI_API_KEY.
# AI_PROVIDER=fake
GEMINI_API_KEY=

# The Bot Check on sign-up, sign-in and password reset: Cloudflare Turnstile's site key, which the
# forms' widget uses, and its secret, which stays on the server. Without the secret the Bot Check is
# off and the forms show no widget, the local development default; on Production a missing secret
# fails the build, so the last deploy stays live.
# Production uses the real keys from the Cloudflare dashboard, and Preview Turnstile's always-pass
# test keys: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# The fake AI adapter, the default everywhere. FAKE_AI_SCENARIO picks its outcome (pass, or another
# scenario listed in src/server/ai/fake.ts) and FAKE_AI_DELAY_MS how long each call takes (default
# 1000). In local development a browser's fake_ai_scenario cookie overrides FAKE_AI_SCENARIO for that
# browser alone, for the photo check only: Stylings run in the Workflow, so tailoring and Preview
# scenarios need FAKE_AI_SCENARIO.
# FAKE_AI_SCENARIO=pass
# FAKE_AI_DELAY_MS=1000

# Qloo's hackathon API (https://hackathon.api.qloo.com) and its key. Local development uses real Qloo
# too, through the same cache in the database.
QLOO_API_KEY=
QLOO_API_URL=

# The team Gmail account that sends every email, over SMTP, on Vercel. scripts/setup-team-gmail.sh sets
# both, and makes a new app password after the account's password changes. Local development never
# sends real email: each one is written to .data/inbox instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The Demo Account's password, read only by `npm run team:create-demo-account`. Set it in the shell for
# that one run, never in .env.local or any other file.
# DEMO_ACCOUNT_PASSWORD=

# The secret Vercel Cron sends with its daily call to /api/daily-sweep, which refuses any request
# without it, so the sweep never runs until it's set. Set it on Vercel for Production, as at least 16
# random characters (openssl rand -base64 32). Set it in .env.local only to run the sweep by hand.
# CRON_SECRET=
