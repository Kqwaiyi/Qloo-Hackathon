# Copy to .env.local for local development. Secrets never go in tracked files.

# Neon Postgres (set by the Vercel Marketplace integration). Leave unset locally to use an
# on-disk PGlite database in .data/pglite instead.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Required on Vercel. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Optional: the URL the app is served from. Defaults to the Vercel deployment URL, or
# http://localhost:3000 in local development.
# BETTER_AUTH_URL=

QLOO_API_KEY=
QLOO_API_URL=
GEMINI_API_KEY=

# The team Gmail account that sends every email, over SMTP. scripts/setup-team-gmail.sh sets both,
# and makes a new app password after the account's password changes.
GMAIL_USER=
GMAIL_APP_PASSWORD=
