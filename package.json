{
  "name": "outfit-recommender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:photo-style-tags": "tsx --env-file=.env.local scripts/check-photo-style-tags.ts",
    "check:product-search-coverage": "tsx --env-file=.env.local scripts/check-product-search-coverage.ts",
    "team:create-demo-account": "tsx scripts/create-demo-account.ts",
    "team:delete-account": "tsx scripts/delete-account.ts",
    "team:correct-birth-date": "tsx scripts/correct-birth-date.ts",
    "team:export-landing-sample": "tsx scripts/export-landing-sample.ts",
    "team:make-landing-sample": "tsx --env-file=.env.local scripts/make-landing-sample.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/google": "4.0.95",
    "@electric-sql/pglite": "0.5.10",
    "@gsap/react": "2.1.2",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.10.1",
    "ai": "7.0.140",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.4.1",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "workflow": "5.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
